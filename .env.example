# OpenRouter key used only by the photo scanner (api/scan.js). Give it a spending limit in OpenRouter.
OPENROUTER_API_KEY=

# Usage counts (api/track.js). Vercel fills in the KV_ ones when an Upstash database is connected.
KV_REST_API_URL=
KV_REST_API_TOKEN=
STATS_TOKEN=

# Instacart "Shop ingredients" (api/instacart.js). Set INSTACART_ENV=production with a production key.
INSTACART_API_KEY=
INSTACART_ENV=

# Kroger "Add to my cart" (api/kroger/). KROGER_BANNER: qfc (default), kroger, fredmeyer, ralphs.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_BANNER=
